<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <Nullable>disable</Nullable>
        <RootNamespace>PrivateMemoryTests</RootNamespace>
        <AssemblyName>PrivateMemoryTests</AssemblyName>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <!-- Standalone harness: not part of LinuxCompat.sln. The Directory.Build.props next to
             this file shadows the repository root's, keeping the plugin's Steam/game path
             detection out of the test build. -->
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    </PropertyGroup>

    <ItemGroup>
        <!-- The code under test, compiled verbatim from the plugin sources. -->
        <Compile Include="../../Shared/Patches/SystemAbstraction/ProcessPrivateMemory.cs" Link="ProcessPrivateMemory.cs" />
        <Compile Include="Program.cs" />
    </ItemGroup>

</Project>
