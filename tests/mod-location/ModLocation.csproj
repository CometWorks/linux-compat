<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ModLocation</RootNamespace>
        <AssemblyName>ModLocation</AssemblyName>
        <!-- Standalone harness: not part of LinuxCompat.sln. The Directory.Build.props next to
             this file shadows the repository root's, keeping the plugin's Steam/game path
             detection out of the test build. -->
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
        <Bin64 Condition="'$(Bin64)' == ''">$(HOME)/.steam/steam/steamapps/common/SpaceEngineers/Bin64</Bin64>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compile against the game, but leave it out of the output: Program.cs loads it from
             Bin64 at run time, like the plugin under test. -->
        <Reference Include="$(Bin64)/Sandbox.Game.dll" Private="false" />
        <Reference Include="$(Bin64)/VRage.dll" Private="false" />
        <Reference Include="$(Bin64)/VRage.Game.dll" Private="false" />
        <Reference Include="$(Bin64)/VRage.Library.dll" Private="false" />
    </ItemGroup>

</Project>
