<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <RootNamespace>ServerPlugin</RootNamespace>
        <AssemblyName>LinuxCompatServer</AssemblyName>
        <LangVersion>13</LangVersion>

        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

        <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>$(DefineConstants);DEDICATED</DefineConstants>
    </PropertyGroup>

    <!-- Null-render servers require VRage.Render for model and LOD loading. -->
    <ItemGroup>
        <Reference Include="HavokWrapper">
            <HintPath>$(DS64)/HavokWrapper.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System.Collections.Immutable">
            <HintPath>$(DS64)/System.Collections.Immutable.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis">
            <HintPath>$(DS64)/Microsoft.CodeAnalysis.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Microsoft.CodeAnalysis.CSharp">
            <HintPath>$(DS64)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Sandbox.Common">
            <HintPath>$(DS64)/Sandbox.Common.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Sandbox.Game">
            <HintPath>$(DS64)/Sandbox.Game.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="SpaceEngineers.Game">
            <HintPath>$(DS64)/SpaceEngineers.Game.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="SpaceEngineers.ObjectBuilders">
            <HintPath>$(DS64)/SpaceEngineers.ObjectBuilders.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage">
            <HintPath>$(DS64)/VRage.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Ansel">
            <HintPath>$(DS64)/VRage.Ansel.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Game">
            <HintPath>$(DS64)/VRage.Game.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Library">
            <HintPath>$(DS64)/VRage.Library.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Math">
            <HintPath>$(DS64)/VRage.Math.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Platform.Windows">
            <HintPath>$(DS64)/VRage.Platform.Windows.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Render">
            <HintPath>$(DS64)/VRage.Render.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Scripting">
            <HintPath>$(DS64)/VRage.Scripting.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VRage.Steam">
            <HintPath>$(DS64)/VRage.Steam.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Steamworks.NET">
            <HintPath>$(Steamworks)/Steamworks.NET.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony" Version="2.4.2" />
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Mono.Cecil" Version="0.11.6"/>
    </ItemGroup>

    <PropertyGroup>
        <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
        <PublicizerRuntimeStrategies>Unsafe;IgnoresAccessChecksTo</PublicizerRuntimeStrategies>
        <PublicizerLogFilePath>$(MSBuildProjectDirectory)/$(OutputPath)Krafs.Publicizer.log</PublicizerLogFilePath>
    </PropertyGroup>

    <ItemGroup>
        <Publicize Include="Sandbox.Game"/>
        <Publicize Include="Sandbox.ObjectBuilders"/>
        <Publicize Include="SpaceEngineers"/>
        <Publicize Include="SpaceEngineers.Game"/>
        <Publicize Include="VRage"/>
        <Publicize Include="VRage.Platform.Windows"/>
        <Publicize Include="VRage.Scripting"/>
        <Publicize Include="VRage.Steam"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Patches/" />
    </ItemGroup>

    <Target Name="ValidateDS64" BeforeTargets="PrepareForBuild">
        <Error Condition="!Exists('$(DS64)')" Text="Specify SpaceEngineers DedicatedServer64 path!" />
        <Error Condition="!Exists('$(Steamworks)/Steamworks.NET.dll')" Text="Specify Steamworks path!" />
        <Warning Condition="!Exists('$(Dependencies)')" Text="Plugin will fail at runtime without linux-dependencies!" />
        <Warning Condition="!Exists('$(Wrappers)')" Text="Plugin will fail at runtime without linux-native-wrappers!" />
        <Warning Condition="'$(Magnetar)' == ''" Text="Skipping deployment due to unset Magnetar folder!" />
    </Target>

    <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(Magnetar)' != ''">
        <PropertyGroup>
            <FolderName>Legacy</FolderName>
            <FolderName Condition="Exists('$(Magnetar)/Interim')">Interim</FolderName>
            <PluginDirectory>$(Magnetar)/$(FolderName)/Local/linux-compat</PluginDirectory>
        </PropertyGroup>
        <ItemGroup>
            <Deploy Include="$(Dependencies)/**/*" Condition="'$(Dependencies)' != ''" />
            <Deploy Include="$(Wrappers)/**/*" Condition="'$(Wrappers)' != ''" />
        </ItemGroup>
        <MakeDir Directories="$(PluginDirectory)" />
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PluginDirectory)/plugin.dll" />
        <Copy SourceFiles="@(Deploy)" DestinationFolder="$(PluginDirectory)" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)/ServerPlugin.xml" DestinationFiles="$(PluginDirectory)/plugin.xml" />
    </Target>

    <Import Project="../Shared/Shared.projitems" Label="Shared" />
</Project>
